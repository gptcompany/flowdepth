<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.gobabygo.dash-core</string>
	<!-- The symlink `current` selects the build; rollback re-points it (README, launchd section). -->
	<key>ProgramArguments</key>
	<array>
		<string>/Users/@USER@/.local/share/dash-core/current/dash-core</string>
	</array>
	<!-- Loopback only: render-plist.py refuses any other DASH_BIND. @PROM_URL@ comes from
	     render-plist.py prom-url (the current Prometheus node, monitoring-stack runbook).
	     DASH_REKTSLUG_URL is left unset on purpose, so the rektslug sheet reads missing. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>DASH_BIND</key>
		<string>127.0.0.1:8790</string>
		<key>DASH_PROM_URL</key>
		<string>@PROM_URL@</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<!-- Restart when it exits, e.g. a bind failure. -->
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>StandardOutPath</key>
	<string>/Users/@USER@/.local/state/dash-core/dash-core.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/@USER@/.local/state/dash-core/dash-core.log</string>
</dict>
</plist>
